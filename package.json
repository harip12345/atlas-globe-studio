{
  "name": "atlas-globe-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Editable, deterministic globe motion graphics for short videos",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
