    "agent": "node scripts/agent.js",
    "build:geo": "node scripts/build-geolib.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "playwright-core": "1.65.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
